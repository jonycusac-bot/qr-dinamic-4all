{
  "name": "qr-dinamic-4all",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); if(fs.existsSync('server.js')) fs.rmSync('server.js');\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/neon-check.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:neon": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/neon-integration.ts",
    "db:migrate:tenants": "node scripts/migrate-tenants.mjs",
    "test:tenants": "node --import tsx scripts/tenant-integration.ts",
    "dev:accounts": "node --env-file=.env.multiempresa.local --import tsx server.ts",
    "account:activate": "node --import tsx scripts/activate-company.ts",
    "test:accounts": "node --import tsx scripts/account-integration.ts",
    "build:accounts": "node --env-file=.env.multiempresa.local node_modules/vite/bin/vite.js build --outDir dist-accounts"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neondatabase/auth": "^0.6.0-beta",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vercel/functions": "^3.10.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
